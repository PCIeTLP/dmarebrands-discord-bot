{
  "name": "dmarebrands-discord-bot",
  "version": "1.0.0",
  "description": "Discord bot for the dmarebrands Partner API",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
